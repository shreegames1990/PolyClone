# Optional. Enables the full RainbowKit wallet list (WalletConnect, mobile wallets).
# Without it, only injected browser wallets (MetaMask, Rabby, …) are offered.
# Get a free project ID at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Polygon RPC used by wagmi. Defaults to the public RPC, which is rate limited.
NEXT_PUBLIC_POLYGON_RPC_URL=

# Optional, local development only. Sends server-side Polymarket API calls through
# another deployment's /api/pm proxy, for regions where Polymarket is blocked.
# Leave unset on the deployed app itself, or it would proxy to itself.
# PM_REMOTE_PROXY_URL=https://polyclone-production.up.railway.app
PM_REMOTE_PROXY_URL=

# Polymarket Builder API credentials (server-only; never prefix with NEXT_PUBLIC_).
# Enable gasless trading approvals for Polymarket proxy wallets via /api/builder/sign.
# Get them from Polymarket's Builder settings. Leave empty to disable builder signing.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
