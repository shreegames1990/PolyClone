# Optional. Enables the full RainbowKit wallet list (WalletConnect, mobile wallets).
# Without it, only injected browser wallets (MetaMask, Rabby, …) are offered.
# Get a free project ID at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Polygon RPC used by wagmi. Defaults to the public RPC, which is rate limited.
NEXT_PUBLIC_POLYGON_RPC_URL=
